<Window x:Class="StudyLock.BankEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地题库编辑器" Width="1060" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FFF2F4F7" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="#FF1A73E8" Padding="18,12">
            <StackPanel>
                <TextBlock Text="本地题库编辑器" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="PathText" Foreground="#FFD6E4FF" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：题目列表 -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="＋ 新建题目" Click="OnNew" Padding="12,8" HorizontalAlignment="Left"
                            Background="#FF34A853" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <TextBox x:Name="SearchBox" Margin="0,8,0,0" Padding="7"
                             TextChanged="OnSearch" ToolTip="输入关键字筛选题干"/>
                </StackPanel>
                <Border Background="White" CornerRadius="8" BorderBrush="#FFDDE2E8" BorderThickness="1">
                    <DockPanel>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Padding="10,6"
                                   FontSize="12" Foreground="#FF6B7684"/>
                        <ListBox x:Name="QuestionList" DisplayMemberPath="Display"
                                 BorderThickness="0" Margin="4" SelectionChanged="OnSelect"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- 右侧：编辑表单 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#FFDDE2E8" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="题干（题目本身）" FontWeight="Bold"/>
                        <TextBox x:Name="TextQ" Height="88" Margin="0,6,0,0" AcceptsReturn="True"
                                 TextWrapping="Wrap" Padding="8" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="四个选项，并勾选正确答案" FontWeight="Bold" Margin="0,16,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="A" VerticalAlignment="Center"/>
                            <TextBox x:Name="OptA" Grid.Row="0" Grid.Column="1" Padding="6" Margin="0,3"/>
                            <RadioButton x:Name="RbA" Grid.Row="0" Grid.Column="2" Content="正确"
                                         GroupName="Ans" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="B" VerticalAlignment="Center"/>
                            <TextBox x:Name="OptB" Grid.Row="1" Grid.Column="1" Padding="6" Margin="0,3"/>
                            <RadioButton x:Name="RbB" Grid.Row="1" Grid.Column="2" Content="正确"
                                         GroupName="Ans" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="C" VerticalAlignment="Center"/>
                            <TextBox x:Name="OptC" Grid.Row="2" Grid.Column="1" Padding="6" Margin="0,3"/>
                            <RadioButton x:Name="RbC" Grid.Row="2" Grid.Column="2" Content="正确"
                                         GroupName="Ans" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="D" VerticalAlignment="Center"/>
                            <TextBox x:Name="OptD" Grid.Row="3" Grid.Column="1" Padding="6" Margin="0,3"/>
                            <RadioButton x:Name="RbD" Grid.Row="3" Grid.Column="2" Content="正确"
                                         GroupName="Ans" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="科目" FontWeight="Bold"/>
                                <ComboBox x:Name="SubjectBox" Margin="0,6,6,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="年级" FontWeight="Bold"/>
                                <ComboBox x:Name="GradeBox" Margin="0,6,6,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="难度" FontWeight="Bold"/>
                                <ComboBox x:Name="DiffBox" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="解析（答错时显示给孩子看，可留空）" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBox x:Name="ExplainQ" Height="72" Margin="0,6,0,0" AcceptsReturn="True"
                                 TextWrapping="Wrap" Padding="8" VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="保存到本地题库" Click="OnSave" Padding="18,9"
                                    Background="#FF1A73E8" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="删除此题" Click="OnDelete" Padding="14,9" Margin="10,0,0,0"
                                    Background="#FFD93025" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="清空表单" Click="OnClear" Padding="14,9" Margin="10,0,0,0"
                                    Background="#FF8A94A0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="导出给电视（JSON）" Click="OnExport" Padding="14,9" Margin="10,0,0,0"
                                    Background="#FF2BB673" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFE8EEF5" Padding="16,9">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FF3C4A5A" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
