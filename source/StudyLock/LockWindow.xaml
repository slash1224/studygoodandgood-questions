<Window x:Class="StudyLock.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False" Background="#FF101418"
        Cursor="Arrow" KeyDown="OnKeyDown">
    <Grid>
        <!-- 底部名言警句（所有视图共享，锁屏期间每分钟换一条） -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="#0D000000" Padding="20,14">
            <TextBlock x:Name="QuoteText" Text="" FontSize="17" Foreground="#FF8FA3B8"
                       FontStyle="Italic" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <!-- 调试模式标识（仅本机调试时出现） -->
        <TextBlock x:Name="DebugBadge" Text="调试模式（可 Alt+F4 关闭）" FontSize="13"
                   Foreground="#FFFBBC05" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,10,14,0" Visibility="Collapsed"/>
        <!-- 主锁定视图 -->
        <Grid x:Name="HomeView" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                <TextBlock Text="先学习，再娱乐" FontSize="42" FontWeight="Bold"
                           Foreground="#FF4DA3FF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="" FontSize="18" Foreground="#FFAAB4C0"
                           HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="FreeWindowText" Text="" FontSize="14" Foreground="#FF6B7684"
                           HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="StartQuizBtn" Content="开始答题解锁" FontSize="22" Padding="40,14"
                        Margin="0,30,0,0" Background="#FF1A73E8" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="OnStartQuiz"/>
                <Button Content="家长管理" FontSize="14" Padding="20,8" Margin="0,16,0,0"
                        Background="#FF2A2F36" Foreground="#FFAAB4C0" BorderThickness="0"
                        Cursor="Hand" Click="OnParentPanel"/>
                <TextBlock x:Name="BankInfo" Text="" FontSize="12" Foreground="#FF4A525C"
                           HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 答题视图 -->
        <Grid x:Name="QuizView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="720">
                <TextBlock x:Name="ProgressText" Text="第 1/5 题" FontSize="16" Foreground="#FF6B7684"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubjectText" Text="" FontSize="14" Foreground="#FF4DA3FF"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Border Background="#FF1A1F26" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                    <TextBlock x:Name="QuestionText" Text="" FontSize="22" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
                <StackPanel x:Name="OptionsPanel" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 结果视图 -->
        <Grid x:Name="ResultView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640">
                <TextBlock x:Name="ResultTitle" Text="" FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ResultDetail" Text="" FontSize="18" Foreground="#FFAAB4C0"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="ExplainText" Text="" FontSize="14" Foreground="#FF8A94A0"
                           HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="ResultBtn" Content="好的" FontSize="18" Padding="36,10" Margin="0,26,0,0"
                        Background="#FF1A73E8" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="OnResultOk" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 家长面板（密码+二维码） -->
        <Grid x:Name="ParentView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                <TextBlock Text="家长管理" FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <PasswordBox x:Name="PwdBox" Margin="0,20,0,0" FontSize="18" Padding="8"
                             Background="#FF1A1F26" Foreground="White" BorderThickness="1"
                             BorderBrush="#FF3A424C"/>
                <Button Content="验证并显示管理二维码" FontSize="16" Padding="24,8" Margin="0,14,0,0"
                        Background="#FF1A73E8" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="OnVerifyParent"/>
                <TextBlock x:Name="PwdError" Text="密码错误" FontSize="13" Foreground="#FFD93025"
                           HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Image x:Name="QrImage" Width="220" Height="220" Margin="0,20,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="QrTip" Text="" FontSize="13" Foreground="#FFAAB4C0" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
                <Button x:Name="EditorBtn" Content="本地题库编辑器（家长）" FontSize="14" Padding="24,9"
                        Margin="0,18,0,0" Background="#FF2A2F36" Foreground="#FFAAB4C0"
                        BorderThickness="0" Cursor="Hand" Click="OnOpenEditor" Visibility="Collapsed"/>
                <TextBlock Text="录入自己出的题目；错题会在锁屏时优先出现" FontSize="12"
                           Foreground="#FF6B7684" HorizontalAlignment="Center" Margin="0,6,0,0"
                           x:Name="EditorTip" Visibility="Collapsed"/>
                <Button Content="返回" FontSize="14" Padding="20,6" Margin="0,20,0,0"
                        Background="#FF2A2F36" Foreground="#FFAAB4C0" BorderThickness="0"
                        Cursor="Hand" Click="OnBackHome" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
