<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BankEditor</AssemblyName>
    <RootNamespace>StudyLock</RootNamespace>
    <ApplicationManifest>..\StudyLock\app.manifest</ApplicationManifest>
    <StartupObject>StudyLock.EditorProgram</StartupObject>
    <!-- 与主程序一致：单文件发布时把 WPF 原生库打包进 exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- 与主程序共用同一套源码，保证读写规则一致 -->
    <Compile Include="..\StudyLock\Models.cs" />
    <Compile Include="..\StudyLock\Guardian.cs" />
    <Compile Include="..\StudyLock\QuestionStats.cs" />
    <Compile Include="..\StudyLock\QuestionBank.cs" />
    <Compile Include="..\StudyLock\BankEditorWindow.xaml.cs" />
    <Page Include="..\StudyLock\BankEditorWindow.xaml" Link="BankEditorWindow.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>
</Project>
